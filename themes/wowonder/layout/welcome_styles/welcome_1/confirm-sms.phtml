<style>
	.login {
		max-width: fit-content;
		min-height: fit-content;
	}
	.login form {
    	padding: 30px 40px;
		padding-bottom: auto;
	}
	.col-md-6{
		width: 100%;
	}
	@media (max-width:880px) {
		.footer-container {
			position: absolute!important;
			padding: 30px 0px;
		}
	}
</style>
<div class="back-img">
<div class="wrapper">
	<div class="login animated animated_5">
		<div class="col-md-6">

		<form id="confirm-form" class="animated animated_9 login-form" method="post">
		<div class="form-logo">
					<a href="<?php echo $wo['config']['site_url'];?>"><img src="<?php echo $wo['config']['theme_url'];?>/img/logo.<?php echo $wo['config']['logo_extension'];?>" alt="Logo"> </a>
				</div>
	<h5 class="title">Confrim your phone</h5>
					<div id="hideMsg" class="item">
						<h2><span>60</span></h2>
					</div>
					<div class="form-group" id="re-send" style="display:none">
						<div class="text-center"><?php echo $wo['lang']['activation_get_code_again'];?> <a href="javascript:void(0);" onclick="Wo_ResendCode();"><?php echo $wo['lang']['activation_resend'];?></a></div>
					</div>
					<div class="errors"></div>
					<div class="wow_form_fields" style="width: 100%;">
						<label for="tag_field"><?php echo $wo['lang']['phone_number']?></label>
						<input name="phone_num" type="tel" autocomplete="off" placeholder=" " value="<?php echo $wo['confirm_user']['phone_number'];?>" required>
					</div>
					<div class="wow_form_fields" style="width: 100%;">
						<label for="tag_field"><?php echo $wo['lang']['confirmation_code']?></label>
						<input name="confirm_code" type="text" autocomplete="off" placeholder=" " autofocus required>
					</div>
					<input type="hidden" name="user_id" id="confirm-user-id" value="<?php echo $wo['confirm_user']['user_id'];?>"/>
					<div class="login_signup_combo">
						<div class="login__">
							<button type="submit" style="background: #3c5cff !important;" class="btn btn-main btn-mat btn-mat-raised add_wow_loader"><?php echo $wo['lang']['confirm']?></button>
						</div>
					</div>
				</form>
		</div>
	</div>
	<div class="container footer-container" style="position: absolute;bottom: 5px;text-align: center;left: 50%;transform: translateX(-50%);"><?php echo Wo_LoadPage('footer/welcome');?></div>
</div>
</div>


<script>
var working = false;
var $this = $('#confirm-form');
var $state = $this.find('.errors');
var $login_anim = $('.tag_auth_animation');

$(function() {
	Wo_SetTimer();
	$this.ajaxForm({
		url: Wo_Ajax_Requests_File() + '?f=confirm_user',
		beforeSend: function() {
			working = true;$this.find('button').attr("disabled", true);
		},
		success: function(data) {
			if (data.status == 200) {
				$login_anim.removeClass('d-none');
				setTimeout(function () {
					window.location.href = data.location;
				}, 1000);
			} else {
				$this.find('button').attr("disabled", false);
				$state.html(data.errors);
			}
			working = false;
		}
	});
});
</script>
